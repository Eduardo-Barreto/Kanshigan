{
  "name": "kanshigan-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test src ./.claude/hooks ./scripts ./.oxlint-plugins",
    "test:e2e": "playwright test",
    "knip": "knip",
    "react-doctor": "react-doctor",
    "doctor": "oxlint && oxfmt --check . && tsc -b && knip && bun run test",
    "policy": "bun scripts/diff-policy.ts",
    "prepare": "lefthook install",
    "dev:api": "bun --watch src/server/main.ts",
    "dev:web": "vite",
    "start": "bun run build && bun src/server/main.ts",
    "serve": "bun src/server/main.ts",
    "tailnet": "bun scripts/expose.ts tailnet",
    "funnel": "bun scripts/expose.ts funnel",
    "expose:off": "bun scripts/expose.ts off"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.22.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@happy-dom/global-registrator": "^20.10.6",
    "@oxlint/plugins": "^1.77.0",
    "@playwright/test": "^1.61.1",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "knip": "^6.23.0",
    "lefthook": "^2.1.9",
    "oxfmt": "0.56.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react-doctor": "^0.5.8",
    "shadcn": "^4.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.6"
}
